{
  "name": "@gage/notifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "gage notifier: expiry reminders and reward notices by email, Telegram and web push",
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-sqlite tsx watch src/index.ts",
    "start": "node --experimental-sqlite dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts",
    "test": "NODE_OPTIONS=--experimental-sqlite vitest run",
    "sign": "tsx scripts/sign.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "viem": "^2.56.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
