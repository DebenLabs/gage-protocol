# Copy to .env and never commit the copy (.env is gitignored at the repo root).

PORT=4200
CHAIN_ID=46630
INDEXER_URL=http://localhost:42069
INDEXER_TIMEOUT_MS=10000
# Earn discovery, paginated snapshots, events and keeper alerts come from INDEXER_URL.
# Health reads /health/indexer; addresses and the curator come from /earn/strategies.
# No strategy override or separate curator destination is accepted. The curator and depositors
# use their signed /notify subscriptions; the expiry preference also enables Earn notices.
EARN_MAX_SNAPSHOT_AGE_SEC=300
# SQLite file; subscriptions, once-only ledger and failed-message retries must survive restarts.
# Railway: mount persistent storage at this path. ":memory:" is only for throwaway runs.
DB_PATH=./data/notifier.db
POLL_INTERVAL_MS=60000

# Copy: time zone for every deadline (IANA), USDG decimals for amounts, base URL for deal links.
NOTIFY_TIMEZONE=UTC
USDG_DECIMALS=6
APP_URL=https://gage.cash

# A signed `gage notify ...` message older than this is rejected.
SIGNATURE_MAX_AGE_SEC=600
# Optional. With an RPC, ERC-1271 smart-wallet signatures are accepted too (without it, EOA signatures only) and
# the T-24h reminder can say what the borrower's wallet holds (USDG address from DEPLOYMENT_FILE).
RPC_URL=
DEPLOYMENT_FILE=../../contracts/deployments/46630.json

# Channels. Leave a channel's credentials empty and it falls back to the console adapter (sends recorded as "dry").
RESEND_API_KEY=
FROM_EMAIL=gage <reminders@gage.cash>
TELEGRAM_BOT_TOKEN=
# Optional: Telegram's `secret_token` for setWebhook, checked on /telegram/webhook.
TELEGRAM_WEBHOOK_SECRET=
# `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@gage.cash

MAX_SEND_ATTEMPTS=5
LOG_LEVEL=info
