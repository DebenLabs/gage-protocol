# Copy to .env (gitignored). No secrets belong here; every value is public infrastructure.
RPC_URL=https://rpc.testnet.chain.robinhood.com
PORT=4100
INDEXER_URL=http://localhost:42069
# Deployment json with contract addresses and, once the token layer is deployed, PoolManager / PositionManager / StateView / pools
DEPLOYMENT_FILE=../../contracts/deployments/46630.json
# Blockscout API v2 root
EXPLORER_API=https://explorer.testnet.chain.robinhood.com/api/v2
# Where the hourly price / market-cap samples are persisted (JSON). Relative to the package directory.
DATA_DIR=./data
# Comma-separated addresses treated as liquidity lockers (timelocks, launchpad lockers). SeedTimelock from the deployment is always included.
KNOWN_LOCKERS=
# Multiplier on the term-scaled realised volatility used for the Recommended range width (1.5 ≈ 87% terminal coverage)
RANGE_SIGMA_MULTIPLIER=1.5
# Milliseconds a block number is trusted before it is re-read (per-block cache TTL)
BLOCK_TTL_MS=1000
# Hourly sampler; set to 0 to disable (tests never start it)
SAMPLE_INTERVAL_MS=3600000
# Milliseconds a token's facts panel (explorer holders, contract checks) is reused before being rebuilt
FACTS_TTL_MS=300000
