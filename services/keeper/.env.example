# Copy to .env and never commit the copy (.env is gitignored at the repo root).

# Chain
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
RPC_FALLBACK_URL=
# Deployment json with contract addresses; token-layer keys are picked up when they appear, no restart needed.
DEPLOYMENT_FILE=../../contracts/deployments/46630.json

# Hot wallet. Holds gas only. Unset = dry-run. Never logged, never committed.
KEEPER_KEY=
# Force simulation-only even with a key.
DRY_RUN=true
# Job allowlist, comma-separated (earn, graduation, seed, fees, register, epoch, checkpoint, swapWatch,
# streamerBoundary, streamerDeposit, backstop, price, rates, prep, gas). Empty = every job. A staging keeper
# with its own wallet runs KEEPER_JOBS=earn so it never repeats the production keeper's maintenance.
KEEPER_JOBS=
# Refuse to send below this balance and log a warning line.
MIN_GAS_ETH=0.01

# Fees job
MAX_CLIP_USDG=1000
FEE_SWEEP_MIN_USDG=0

# Checkpoint job: "chain" scans PositionManager Transfer events; or a URL returning tokenIds (see README).
POSITIONS_SOURCE=chain
CHECKPOINT_BATCH=50
INDEXER_URL=http://localhost:42069

# Log scanning. Defaults to the deployment's `startBlock`, else the known M1 deploy block for the chain.
SCAN_FROM_BLOCK=
LOG_CHUNK_BLOCKS=20000

# Register job
REGISTER_MAX_PER_RUN=20

# Epoch jobs
EPOCH_LOOKBACK=4
# Emissions.REGISTRATION_GRACE (6 hours on the final contract): rollover/finalize are not attempted before it.
REGISTRATION_GRACE=6h
EPOCH_PREP_LEAD=24h
# Monday epoch-1 interim policy uses 6667 (about 40% lender / 20% borrower
# when gross deal emissions are 60%). Keep 5000 for an equal split.
LENDER_SHARE_BPS=5000
TWAP_WINDOW=24h
# Owner-only reward-rate maintenance. Explicit opt-in, same serialized wallet.
RATES_ENABLED=false
RATES_START_EPOCH=1

# LP streamer (D64). Every job below no-ops until the deployment json carries an `LPStreamer` key.
# The boundary job runs LPStreamer.checkpointMany over every scoring position from this many seconds before each
# epoch boundary (and once more the same length of time after it). Never only after.
STREAMER_BOUNDARY_LEAD_SECONDS=600
# The deposit job claims the backstop deals' drips and deposits the wallet's whole sGAGE balance once it is at least this (human sGAGE).
STREAMER_DEPOSIT_MIN_SGAGE=1000
# Backstop: the keeper wallet funds a V1 deal with itself on both sides so its fee reserves the epoch's unreserved deal
# budget before it rolls over as a lump. Off = the job only logs its plan (`backstop_plan`). Needs KEEPER_KEY too.
BACKSTOP_ENABLED=false
# New backstop deals are listed and funded only inside this many seconds before the epoch's end.
BACKSTOP_WINDOW_SECONDS=14400
# Unreserved budget (human sGAGE) at or below this is left to roll over.
BACKSTOP_MIN_SGAGE=1000000
# ERC-20 posted as collateral (must be allowlisted on the V1 registry); empty = the deployment's `WETH` key.
BACKSTOP_COLLATERAL_TOKEN=
# Raw units; empty = the registry minimum for the token (mainnet WETH: 40151162267406354 = 0.0402 WETH).
BACKSTOP_COLLATERAL_AMOUNT=

# Intervals (ms, s, m, h, d)
CHECKPOINT_INTERVAL=1h
# Swap watcher: scans the GAGE/sGAGE pool's Swap events and checkpoints every position as soon as one lands.
SWAP_WATCH_INTERVAL=5s
REGISTER_INTERVAL=10m
EPOCH_INTERVAL=1m
FEES_INTERVAL=30m
PREP_INTERVAL=1h
PRICE_SAMPLE_INTERVAL=5m
STREAMER_BOUNDARY_INTERVAL=1m
STREAMER_DEPOSIT_INTERVAL=1h
BACKSTOP_INTERVAL=30m
TICK_INTERVAL=5s

# Earn: requires earnStrategies[] (or the flat HybridVault, HybridReserve and EarnCore keys) in DEPLOYMENT_FILE;
# the job runs once per listed strategy with separate retry state.
# Enumerates complete fixed-block pages from INDEXER_URL; no historical log scan.
EARN_ENABLED=true
EARN_INTERVAL=5s
# ERC-4626 preview tolerance, basis points; 0..1000 (100 = 1%).
EARN_TOLERANCE_BPS=100
# Minimum claimable reward amount in raw token units (1 sGAGE at 18 decimals).
EARN_REWARD_MIN_RAW=1000000000000000000
# Idle strategy cash above which the keeper invests it into the reserve, raw USDG units (1 USDG at 6 decimals).
EARN_INVEST_MIN_RAW=1000000
# Refuse stale snapshots. Positive seconds.
EARN_MAX_AGE_SECONDS=120
# Positive seconds; exponential retries cap at 600 seconds.
EARN_RETRY_BASE_SECONDS=30
# Positive failure count before an incident appears in /health/earn for the notifier.
EARN_ALERT_ATTEMPTS=3
# Railway assigns PORT. /health/earn reports the flagship's last tick and unresolved transaction;
# /health/earn?strategy=<address> answers for one listed strategy (404 otherwise).
PORT=8080

# Output: proposals, transaction journal and Earn retry state. Mount this on a persistent volume.
# On Railway use OUT_DIR=/data/keeper with the volume mounted at /data.
OUT_DIR=./out
LOG_LEVEL=info
# RUN_ONCE=true runs every job once and exits (same as `pnpm once`).
RUN_ONCE=
