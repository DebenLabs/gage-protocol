# Copy to .env and never commit the copy (.env is gitignored at the repo root).

# Chain to index. 46630 = Robinhood Chain Testnet, 4663 = mainnet (not deployed yet).
CHAIN_ID=46630
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Optional private server RPC for live LP earnings (falls back to RPC_URL). Never use NEXT_PUBLIC_ for this.
LP_READ_RPC_URL=
# Optional websocket endpoint for realtime blocks.
RPC_WS_URL=
# First block to index. Defaults to the M1 deployment block for the chain (114410479 on testnet).
START_BLOCK=114410479
# Optional: first block for the token layer and the v4 pool sources. Defaults to START_BLOCK.
TOKEN_START_BLOCK=
# Deployment address table, relative to this package. Defaults to ../../contracts/deployments/<CHAIN_ID>.json.
DEPLOYMENT_FILE=
# Postgres connection string. Leave empty to use PGlite under .ponder/pglite (dev default).
DATABASE_URL=
# HTTP port for the API (Ponder default 42069).
PORT=42069

# Earn is enabled only by HybridVault, HybridReserve and EarnCore (one of nativeV2.engines) in DEPLOYMENT_FILE; its reward ledger is read from that core.
# The file's earnStartBlock must include the initial lane/admission events.
# Refresh external lending conversions while Earn has no transactions (100 blocks is about 10 seconds).
EARN_SNAPSHOT_INTERVAL=100
# Optional keeper service base URL; reads /health/earn with a bounded timeout, never signs.
EARN_KEEPER_URL=
